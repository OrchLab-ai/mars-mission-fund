{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Glob",
      "Grep",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run test:coverage)",
      "Bash(npx vitest *)",
      "Bash(npm run lint)",
      "Bash(npm run lint:md)",
      "Bash(npm run format:check)",
      "Bash(npx eslint *)",

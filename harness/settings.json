    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Read(//etc/**)",
      "Read(~/**)",
      "Edit(//etc/**)",
      "Edit(~/**)"
    ]
  }
